# Google Gemini API Key (Kept strictly on the backend/server, never sent to browser bundle)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model (Primary model: gemini-3.5-flash-lite, fallback: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: Cloudflare AI Gateway
# GEMINI_BASE_URL=https://gateway.ai.cloudflare.com/v1/{account_id}/{gateway_name}/google-ai-studio
# CF_AIG_TOKEN=your_cf_aig_token
